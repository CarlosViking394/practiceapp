# Google Maps Platform key. Create at https://console.cloud.google.com/apis/credentials
#
# Enable these APIs on the project, and restrict the key to them:
#   Geocoding API          — locating addresses
#   Address Validation API — confirming an address is real and deliverable
#   Places API (New)       — schools, parks, playgrounds, childcare
#   Routes API             — real drive/walk times
#
# Restrict by IP (server-side use only). This key must not be exposed to the
# browser; the app reaches Google through this server's /api/* routes.
GOOGLE_MAPS_API_KEY=

# Optional: property listing feeds. Google does not supply these.
DOMAIN_API_KEY=
PROPTRACK_API_KEY=
